# Copy to .env.local. Never commit .env.local.

# Required in production. In local development Keel writes .data/secret if this is empty.
BETTER_AUTH_SECRET=

# Public origin of this server. Session cookies are bound to it.
BETTER_AUTH_URL=http://127.0.0.1:3960

# The account with this email is the super admin. It is not committed.
SUPER_ADMIN_EMAIL=

# AI Tutor Provider configuration:
# Deploy OPENROUTER_API_KEY on Vercel (or in .env.local) to power all AI-capable functions.
OPENROUTER_API_KEY=
# Optional OpenRouter model override (defaults to x-ai/grok-4.7). E.g. openai/gpt-4o-mini, anthropic/claude-3.5-haiku, meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=

# Optional direct xAI configuration. When set, live tutor and voice use xAI.
# The key stays on the server. Leave empty to speak on this device only.
XAI_API_KEY=
